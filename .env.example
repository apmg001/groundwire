# Copy to .env and fill in what you use. Never commit .env.
GROUNDWIRE_CONFIG_PATH=config/groundwire.yaml
GROUNDWIRE_HOST=127.0.0.1
GROUNDWIRE_PORT=8000
GROUNDWIRE_LOG_LEVEL=INFO
GROUNDWIRE_LOG_JSON=false
GROUNDWIRE_WORKERS=1

# Only needed for providers you enable in the config.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
